{
  "manifest_version": 3,
  "name": "软团桌宠下载联动",
  "version": "1.0.0",
  "description": "将活动下载的进度和状态发送到本机桌宠",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "key": ""
}